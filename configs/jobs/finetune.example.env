# Example job spec for scripts/cloud/finetune.sh — the "couple of variables".
#
# This is the SH3 run1_base finetune (see scripts/sh3_run1_cluster05_finetune.sh)
# expressed as env vars. Edit and source it, or copy the values into a task
# YAML's `envs:` block (cloud/finetune.*.yaml), or pass via `ml launch --env`.
#
# Local docker usage:
#   set -a; source configs/jobs/finetune.example.env; set +a
#   docker/run.sh scripts/cloud/finetune.sh

# ── Input (set exactly one) ──────────────────────────────────────────────────
DATASET_CSV=data/datasets/SH3/FINAL_SH3_all_dataset_with_prompts.csv
# PRIMARY_HDF5=outputs/run1_base/SH3_embeddings/SH3_run1_base.compiled_emb.hdf5

# ── Weights / config ─────────────────────────────────────────────────────────
WEIGHT_SET=configs/weights/run1_base.json
FINETUNE_CONFIG=configs/stage3_training/finetune_v1.json
# PROTEOSCRIBE_INIT defaults to proteoscribe_weights from WEIGHT_SET.

# ── Run / output ─────────────────────────────────────────────────────────────
RUN_ID=sh3_run1_clust05_v1
DEVICE=cuda
NGPU=1
EPOCHS=100

# ── Split (cluster-aware; needs mmseqs on PATH — NOT in the base image) ───────
# SPLIT=cluster
# MIN_SEQ_ID=0.5
# TRAIN_FRAC=0.7
# VAL_FRAC=0.2
# TEST_FRAC=0.1

# ── Data location (optional) ─────────────────────────────────────────────────
# Only needed for cloud runs that stream from S3 (entrypoint handles the sync).
# Weights ARE in S3 under biom3/weights (run1_base bundle). The dataset/output
# prefixes are NOT yet finalized — fill them in when the S3 layout is decided.
# BIOM3_WEIGHTS_URI=s3://nm-portal-global-data-955510722784/biom3/weights
# BIOM3_WEIGHTS_INCLUDES="PenCL/run1_base_pencl.ckpt* Facilitator/run1_base_facilitator.ckpt* ProteoScribe/run1_base_proteoscribe.ckpt*"
# BIOM3_DATA_URI=<s3://BUCKET/PREFIX>                 # synced -> /app/data
# BIOM3_OUTPUTS_PUSH_URI=<s3://BUCKET/PREFIX/RUN_ID>  # push /app/outputs on exit
