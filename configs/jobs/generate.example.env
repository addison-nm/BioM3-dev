# Example job spec for scripts/cloud/generate.sh — the "couple of variables".
#
# Edit and source it, copy into a task YAML's `envs:` block
# (cloud/generate.*.yaml), or pass via `ml launch --env`.
#
# Local docker usage:
#   set -a; source configs/jobs/generate.example.env; set +a
#   docker/run.sh scripts/cloud/generate.sh

# ── Input ────────────────────────────────────────────────────────────────────
PROMPTS_CSV=data/datasets/SH3/FINAL_SH3_all_dataset_with_prompts.csv

# ── Weights / config ─────────────────────────────────────────────────────────
WEIGHT_SET=configs/weights/run1_base.json
# Per-stage overrides (win over WEIGHT_SET):
# PENCL_WEIGHTS=weights/PenCL/run1_base_pencl.ckpt
# FACILITATOR_WEIGHTS=weights/Facilitator/run1_base_facilitator.ckpt
# PROTEOSCRIBE_WEIGHTS=weights/ProteoScribe/run1_base_proteoscribe.ckpt

# ── Run / output ─────────────────────────────────────────────────────────────
OUTPUT_PREFIX=sh3_run1_gen_v1
DEVICE=cuda
SEED=0
FASTA=true
# TOKEN_STRATEGY=sample            # sample | argmax
# UNMASKING_ORDER=confidence       # random | confidence | confidence_no_pad

# ── Data location (optional) ─────────────────────────────────────────────────
# Only needed for cloud runs that stream from S3. Weights ARE in S3 under
# biom3/weights; the output prefix is NOT yet finalized — fill it in when decided.
# BIOM3_WEIGHTS_URI=s3://<WEIGHTS_BUCKET>/biom3/weights
# BIOM3_WEIGHTS_INCLUDES="PenCL/run1_base_pencl.ckpt* Facilitator/run1_base_facilitator.ckpt* ProteoScribe/run1_base_proteoscribe.ckpt*"
# BIOM3_OUTPUTS_PUSH_URI=<s3://BUCKET/PREFIX/OUTPUT_PREFIX>  # push /app/outputs on exit
