# Local infra defaults for cloud launches. Copy to configs/jobs/local.env
# (gitignored) and fill in your real identifiers — they're kept out of version
# control. scripts/cloud/mithril_launch.sh auto-loads local.env via --env-file when
# present, so these values override the placeholder defaults in cloud/*.yaml.

# S3 prefix holding the BioM3 weights (entrypoint syncs from here).
BIOM3_WEIGHTS_URI=s3://<YOUR_WEIGHTS_BUCKET>/biom3/weights

# Optional: override the image registry/tag (default is the public GHCR dev image).
# IMAGE=ghcr.io/natural-machine/biom3:cuda-dev
