# Example job spec (sidecar dotenv) for scripts/cloud/pretrain.sh — Stage-3
# ProteoScribe pretraining FROM SCRATCH. Override the task-yaml defaults without
# editing the yaml.
#
# Cloud usage (values here override cloud/pretrain.mithril.yaml envs:):
#   scripts/cloud/mithril_launch.sh cloud/pretrain.mithril.yaml biom3-pt \
#     --env-file configs/jobs/pretrain.env
# Local docker usage:
#   set -a; source configs/jobs/pretrain.example.env; set +a
#   docker/run.sh scripts/cloud/pretrain.sh

# ── Input (required: precompiled Stage-2 embedding HDF5, in-container /app path) ─
PRIMARY_HDF5=data/pretrain.compiled_emb.hdf5

# ── Config ───────────────────────────────────────────────────────────────────
PRETRAIN_CONFIG=configs/stage3_training/pretrain_scratch_v1.json

# ── Run / output ─────────────────────────────────────────────────────────────
RUN_ID=pretrain_scratch_v1
# DEVICE defaults to the image's detected backend (cuda|xpu); override if needed.
NGPU=1
# NNODES defaults to $SKYPILOT_NUM_NODES (or 1); set resources.num_nodes in the yaml.
EPOCHS=100
# EXTRA_ARGS="--batch_size 16 --gradient_clip_val 1.0"   # forwarded to the trainer

# ── Data location (cloud; entrypoint syncs S3 -> /app on every node) ──────────
# BIOM3_DATA_URI=<s3://BUCKET/PREFIX>
# BIOM3_OUTPUTS_PUSH_URI=<s3://BUCKET/PREFIX/RUN_ID>   # pushed from rank-0 node only
