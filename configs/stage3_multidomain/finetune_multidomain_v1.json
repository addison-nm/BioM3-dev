{
  "description": "Component A only: train the cross-domain coupling on top of two frozen per-family experts. The coupling starts at its additive null, so the composed model begins bit-exactly equal to the independent experts. Per-domain captions are re-composed each epoch and embedded to z_c on-device. There is no `device` key and no machines/ base: the accelerator is resolved from biom3.backend.device, so only devices_per_node is a per-machine setting here.",
  "tags": ["multidomain", "component_a"],
  "_base_configs": ["./models/_base_ProteoScribe_multidomain.json"],

  "expert_weights": [
    "weights/ProteoScribe/expert_PF00501.bin",
    "weights/ProteoScribe/expert_PF13193.bin"
  ],
  "domain_ids": ["PF00501", "PF13193"],
  "num_domains": 2,
  "coupling_topology": "all_pairs",

  "train_experts": false,
  "expert_prior_lambda": 0.0,
  "prior_mode": "weight",
  "audit_additive_null": true,

  "finetune_data_path": "data/multidomain_PF00501_PF13193.jsonl",
  "split_manifest_path": "data/multidomain_PF00501_PF13193_split.json",
  "sequence_output_key": "sequences",
  "caption_key": "captions",
  "full_sequence_key": "sequence",
  "domains_key": "domains",
  "lazy_records": false,
  "record_schema": {
    "sequences": {
      "compose": "map_domains",
      "args": {
        "domains_key": "domains",
        "expect_k": 2,
        "output": {"from": "sequence"}
      }
    },
    "captions": {
      "compose": "map_domains",
      "args": {
        "domains_key": "domains",
        "expect_k": 2,
        "output": {
          "compose": "fields_to_caption",
          "args": {
            "fields_key": "fields",
            "add_label": true,
            "key_transform": "upper_spaced",
            "default_dropout": 0.3,
            "dropout_rates": {
              "protein_name": 0.0,
              "family_names": 0.15,
              "function": 0.3
            }
          }
        }
      }
    }
  },

  "stage1_config_path": "configs/inference/stage1_PenCL.json",
  "stage2_config_path": "configs/inference/stage2_Facilitator.json",
  "pencl_weights": "weights/PenCL/run1_base_pencl.bin",
  "facilitator_weights": "weights/Facilitator/run1_base_facilitator.bin",

  "train_alpha": "blend",
  "eval_alpha": "spread",
  "zp_batch_size": 64,

  "seed": 0,
  "epochs": 200,
  "batch_size": 4,
  "num_workers": 4,
  "lr": 2.5e-5,
  "weight_decay": 1e-6,
  "precision": "bf16",
  "devices_per_node": 1,
  "num_nodes": 1,
  "acc_grad_batches": 1,
  "distributed_strategy": "deepspeed",
  "log_every_n_steps": 10,
  "limit_val_batches": 1.0,
  "save_top_k": 3,
  "checkpoint_every_n_epochs": 10,

  "output_root": "./outputs/multidomain",
  "checkpoints_folder": "checkpoints",
  "runs_folder": "runs"
}
