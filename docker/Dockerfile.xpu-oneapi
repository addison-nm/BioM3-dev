# BioM3 — Intel XPU image built on oneAPI (biom3:xpu-oneapi), for Aurora.
#
# This is a SECOND xpu image, not a replacement for docker/Dockerfile.xpu. That
# one works for single-node runs; this one exists to fix multi-node.
#
# WHY A SEPARATE BASE
#   Under host mpiexec, ranks in the Dockerfile.xpu image start and get correct
#   rank ids, but never complete a collective: all 12 spin at ~90% CPU with the
#   GPUs idle. That image carries OpenMPI + pip-installed oneCCL, while Aurora's
#   launcher is Intel MPI, and Lightning's MPIEnvironment asks mpi4py for the
#   rank -- which requires an mpi4py built against an ABI-compatible MPI.
#   intel/oneapi-hpckit supplies Intel MPI and oneCCL, which is why ALCF's own
#   container recipe uses it (_misc/sample_script.sh, mirrored from
#   https://docs.alcf.anl.gov/aurora/containers/containers/).
#
# VERSIONS ARE ALIGNED ON ONEAPI 2025.3
#   Everything here is pinned to the base's oneAPI version, which is also what
#   Aurora's frameworks/2025.3.1 runs. This image first tried torch 2.8.0+xpu
#   (as Dockerfile.xpu pins) and that does not work: 2.8's runtime deps are
#   oneAPI 2025.1.1, so with the 2025.3 base present the loader resolves
#   per-library and one side always breaks -- torch failing on
#   LIBUR_LOADER_0.11, or mpi4py on MPIR_F_MPI_BUFFER_AUTOMATIC, depending on
#   LD_LIBRARY_PATH order. No ordering satisfies both.
#
#   torch 2.10.0+xpu depends on 2025.3, dpctl 0.21.1 requires >=2025.3 (and is
#   Aurora's version), and pip's duplicate Intel MPI / oneCCL are removed so the
#   base's are the only ones present. IPEX is dropped: there is no public 2.10
#   build, and the fork's gate on it is patched out below.
#
# amd64 ONLY, same as Dockerfile.xpu: Intel GPU torch wheels are x86_64-only.
#
# Build:  docker/build.sh --variant xpu-oneapi --platform linux/amd64
# Run:    scripts/aurora/apptainer_mpi_run.sh (host mpiexec, one container/rank)

FROM intel/oneapi-hpckit

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# oneAPI's setvars.sh is unreliable under dash, which is /bin/sh on Ubuntu.
SHELL ["/bin/bash", "-c"]

# BIOM3_MACHINE is deliberately unset, as in Dockerfile.xpu: under Apptainer on
# Aurora /flare is bound, so environment.sh auto-detects `aurora`.

# The base ships python3.12 but no pip and no venv module. (ALCF's recipe warns
# against apt-get here, but that applies to their --fakeroot sandbox build on
# Aurora; this image is built with Docker as root.)
#
#  - git, ca-certificates, wget, gnupg: pip git+ URLs (lightning fork) and the
#    Intel GPU apt repo key.
#  - build-essential: source builds for deps without wheels. mpi4py uses the
#    base's mpiicx, but others (e.g. antlr4-python3-runtime) need a plain cc.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip python3-venv python3-dev \
        build-essential git ca-certificates wget gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -V && python3 -m pip --version && python3 -m venv -h >/dev/null

# Intel GPU user-space runtime. oneapi-hpckit provides the oneAPI runtimes but
# not the Level-Zero GPU *driver*, which must match the host kernel driver.
# The unversioned libze_loader.so, which oneCCL dlopen()s, already exists in this
# base (unlike the Ubuntu base of Dockerfile.xpu); the symlink below is a no-op
# kept so the requirement stays visible if the base changes.
# The base already has Intel's GPU repo configured (with its own keyring), so
# adding a second source entry for it fails with a Signed-By conflict -- install
# straight from what is there.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libze1 libze-intel-gpu1 intel-opencl-icd clinfo \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf libze_loader.so.1 /usr/lib/x86_64-linux-gnu/libze_loader.so

# oras — pulls the GHCR weights bundle (see the BIOM3_WEIGHTS_BUNDLE hook in
# docker/entrypoint.sh).
ARG ORAS_VERSION=1.3.3
ARG TARGETARCH
RUN wget -qO /tmp/oras.tar.gz \
        "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && tar -xzf /tmp/oras.tar.gz -C /usr/local/bin oras \
    && rm /tmp/oras.tar.gz \
    && oras version

# --system-site-packages so the venv can see anything oneAPI installed into the
# system interpreter; pip-installed packages still take precedence.
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv --system-site-packages $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# setuptools<82 ships pkg_resources, which the lightning fork's setup.py imports.
# cython is a build requirement of mpi4py, which is installed below with
# --no-build-isolation and so cannot fetch its own build deps.
RUN pip install --upgrade pip "setuptools<82" wheel cython

# mpi4py compiled against the image's Intel MPI. This is the whole point of the
# oneapi base: Lightning's MPIEnvironment asks mpi4py for the rank, and that
# only works when its MPI matches the launcher's. --no-binary is required --
# a wheel would carry someone else's MPI.
RUN . /opt/intel/oneapi/setvars.sh --force \
    && MPICC=mpiicx pip install --no-binary=mpi4py --no-build-isolation mpi4py \
    && python -c "from mpi4py import MPI; print('mpi4py', MPI.Get_library_version())"

# torch 2.10.0+xpu, NOT the 2.8.0 that Dockerfile.xpu pins. 2.8's runtime deps
# are oneAPI 2025.1.1 while this base is 2025.3; with both present the loader
# picks per-library and one side always breaks:
#   torch  -> libur_loader.so.0: version `LIBUR_LOADER_0.11' not found
#   mpi4py -> libmpifort.so.12: undefined symbol: MPIR_F_MPI_BUFFER_AUTOMATIC
# 2.10.0+xpu depends on 2025.3, matching the base and Aurora's frameworks.
RUN pip install torch==2.10.0+xpu torchvision==0.25.0+xpu \
        --index-url https://download.pytorch.org/whl/xpu

# Custom lightning fork with Intel-GPU support.
RUN pip install --no-build-isolation \
        "git+https://github.com/addison-nm/lightning.git"

# The fork's XPUAccelerator gates on intel_extension_for_pytorch, which has no
# public 2.10 build (Aurora's 2.10.10 is an ALCF source build). The gate is
# vestigial: all three uses of _IPEX_AVAILABLE guard code that then calls
# torch.xpu.is_available() / torch.xpu.device_count() anyway, and the imported
# `ipex` name is never used. Forcing the flag true and dropping the imports
# leaves every branch returning the same native answer.
# BOTH copies must be patched. lightning/pytorch/accelerators/xpu.py gates the
# accelerator; lightning/fabric/accelerators/xpu.py holds the num_xpu_devices()
# that fabric's device_parser._sanitize_gpu_ids consults. Patching only the
# former leaves Lightning rejecting every device with
#   MisconfigurationException: You requested gpu: [0..11] But your machine only has: []
# even though torch.xpu.device_count() reports them.
RUN LDIR="$(python -c 'import lightning, os; print(os.path.dirname(lightning.__file__))')" \
    && for f in "$LDIR/pytorch/accelerators/xpu.py" "$LDIR/fabric/accelerators/xpu.py"; do \
         test -f "$f" || { echo "ERROR: expected $f" >&2; exit 1; }; \
         sed -i 's/^_IPEX_AVAILABLE = RequirementCache.*/_IPEX_AVAILABLE = True  # patched: native torch.xpu covers every use below/' "$f"; \
         sed -i '/^ *import intel_extension_for_pytorch as ipex$/d' "$f"; \
       done \
    && python -c "\
from lightning.fabric.accelerators.xpu import _IPEX_AVAILABLE as F, num_xpu_devices; \
from lightning.pytorch.accelerators.xpu import _IPEX_AVAILABLE as P, XPUAccelerator; \
assert F is True and P is True, ('unpatched', F, P); \
XPUAccelerator(); \
print('both xpu accelerators patched; fabric devices:', num_xpu_devices())"

# pip installs its own impi-rt and oneCCL alongside the base's, as transitive
# dependencies of torch. That is fine here and deliberately left alone: with
# torch 2.10 both resolve to 2021.17, matching the base, so the loader cannot mix
# incompatible versions across one library's dependencies. It is only a problem
# when the versions differ -- with torch 2.8 pip brought 2021.15 and mpi4py then
# failed on MPIR_F_MPI_BUFFER_AUTOMATIC, which is part of why this image pins
# 2.10. Uninstalling them does not stick; pip restores them on the next install.

WORKDIR /app
COPY requirements/ /app/requirements/
RUN pip install -c requirements/constraints-oneapi.txt \
        -r requirements/aurora-oneapi.txt \
        --extra-index-url https://download.pytorch.org/whl/xpu

COPY pyproject.toml environment.sh README.md /app/
COPY src/      /app/src/
COPY scripts/  /app/scripts/
COPY tests/    /app/tests/
COPY configs/  /app/configs/

RUN pip install -c requirements/constraints-oneapi.txt -e ".[app]" \
        --extra-index-url https://download.pytorch.org/whl/xpu \
    && mkdir -p /app/weights /app/data /app/outputs /app/logs

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
