# Per-Dockerfile ignore (BuildKit picks this up for `-f docker/Dockerfile.xpu`).
# Build context is the repo ROOT; patterns below are relative to it.
#
# The Dockerfile uses explicit COPYs (never `COPY . .`), so the image never
# contains these regardless. This file's job is to keep the context that gets
# sent to the daemon small/fast — especially the multi-GB weights/ and data/.

# Large / runtime-populated dirs (gitignored) — mounted or synced at run time.
weights/
data/
outputs/
logs/

# Not needed in the image.
jobs/
demos/
docs/
venvs/

# VCS / tooling / caches.
.git/
.github/
.claude/
.pytest_cache/
**/__pycache__/
*.pyc
*.pyo

# Test scratch (tests/ itself IS copied for `pytest --quick`).
tests/_tmp/

# Editor / OS cruft.
.DS_Store
.vscode/
.idea/
