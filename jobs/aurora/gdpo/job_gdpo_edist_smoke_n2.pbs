#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N gdpo_edist_smoke_n2
#PBS -l walltime=00:40:00
#PBS -l select=2
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -q debug-scaling
#PBS -j oe
# PBS -M <emailaddress>
# PBS -m be

# 2-node smoke for the d_E manifold reward on the multi-node GDPO trainer.
#
# Sibling of job_gdpo_smoke_n2.pbs, but exercising the pieces the production
# job (job_gdpo_edist_sh3_prod_n8.pbs) depends on that nothing has yet run:
#
#   1. REAL CROSS-NODE COLLECTIVES. The pre-submission validation ran
#      world_size=1 through the multinode launcher, so the per-step gradient
#      all-reduce (~350 MB) and the reward/KL-normalizer all-reduces were
#      never actually executed across a fabric. This is the main gap.
#   2. PER-RANK REWARD BINDING. Each rank binds its own PenCL into
#      ManifoldReward and scores its own shard; only rank 0 was ever tested.
#   3. B > 1 SHARDING ACROSS RANKS. _shard_replicas round-robins B*G
#      replicas over ranks; at world_size=1 that mapping is the identity.
#
# Sizing mirrors production's shape at 1/4 scale: B=12, G=8 -> BG=96,
# 48 replicas per rank, 4 per tile. Production is 24/rank; this is heavier
# per rank, so it is a conservative rehearsal rather than an optimistic one.
#
# What to check in the log:
#   - "Bound PenCL into z_p-based reward(s)"       (reward bound)
#   - meta row time_offset=896                     (pre_unmask fix active)
#   - [DIAG] fingerprints IDENTICAL across ranks   (broadcast + all-reduce OK)
#   - uniq == 96 in the step lines                 (no cross-rank duplicates)
#   - 5 steps complete without a barrier hang

projdir=${PBS_O_WORKDIR}
cd ${projdir}

module load frameworks
source ./venvs/biom3-env/bin/activate

# Configurations to edit
config_path=./configs/grpo/gdpo_edist_sh3.json
prompts_path=./configs/grpo/prompts/sh3_v03_mixed_512.txt
stage1_weights=./weights/Run1_frozen_ckpts/Run1_TrackC_step_187000_3b7e39f9.ckpt
stage2_weights=./weights/Run1_frozen_ckpts/v3_mmd_full49M_final.ckpt
stage3_init_weights=./weights/ProteoScribe/blend_sd142k_ep353_ep59.bin

num_nodes=2
batch_size=12                   # B — prompts per step
num_generations=8               # G — BG=96 -> 48/rank -> 4/tile
steps=5
save_steps=99                   # no checkpoints from a smoke
n_quadrature=2
inner_mc=1

# Constant configurations
device=xpu

# Construct the run ID
datetime=$(date +%Y%m%d_%H%M%S)
config_name=$(basename "${config_path}" .json)
run_id=${config_name}_smoke_n${num_nodes}_B${batch_size}_G${num_generations}_s${steps}_V${datetime}

# Direct output to log file
mkdir -p logs
log_fpath=logs/${run_id}.${PBS_JOBID}.o

source environment.sh
./scripts/gdpo_train_multinode.sh \
    ${config_path} \
    ${num_nodes} \
    ${device} \
    ${run_id} \
    --batch_size ${batch_size} \
    --num_generations ${num_generations} \
    --steps ${steps} \
    --save_steps ${save_steps} \
    --n_quadrature ${n_quadrature} \
    --inner_mc ${inner_mc} \
    --prompts_path ${prompts_path} \
    --stage1_weights ${stage1_weights} \
    --stage2_weights ${stage2_weights} \
    --stage3_init_weights ${stage3_init_weights} \
> ${log_fpath} 2>&1
