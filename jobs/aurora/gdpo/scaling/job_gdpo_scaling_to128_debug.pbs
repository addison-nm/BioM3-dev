#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N gdpo_scaling_to128_debug
#PBS -l walltime=01:00:00
#PBS -l select=256
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -q debug-scaling
#PBS -j oe

# Debug-scaling smoke of the small-to-mid-N v03 sweep. 7 sub-runs running
# IN PARALLEL within a 256-node allocation on debug-scaling (1 h max).
# Sub-runs N ∈ {2, 4, 8, 16, 32, 64, 128} each get their own disjoint
# slice of $PBS_NODEFILE.
#
# Same machinery as job_gdpo_scaling_to128.pbs but with steps=5 to fit
# the 1 h walltime. Useful for:
#   - Confirming the K=96 config doesn't OOM at N=128 before committing
#     to the 5 h prod allocation.
#   - Validating the per-sub-run isolation + CXI tunings at full
#     7-way concurrent mpiexec count (the prior iso test only covered
#     2-way concurrency at N=2 + N=4).
#   - Verifying the rank-diag echo lines look correct in all 7 sub-run
#     logs (each rank should see PMI_SIZE matching its sub-run's N).
#
# At K=48 / D=128 / 5 steps the slowest (N=128) is estimated at
#   5 × ~280 s ≈ 23 min compute + ~5 min ESMFold cold load + Python init
#   ≈ 28 min total
# leaving ~30 min margin on the 1 h walltime.
#
# Node accounting (identical to job_gdpo_scaling_to128.pbs):
#   N=2    → lines   1..2     (2 nodes)
#   N=4    → lines   3..6     (4 nodes)
#   N=8    → lines   7..14    (8 nodes)
#   N=16   → lines  15..30    (16 nodes)
#   N=32   → lines  31..62    (32 nodes)
#   N=64   → lines  63..126   (64 nodes)
#   N=128  → lines 127..254   (128 nodes)
#   total used: 254 nodes; spare: 2 (lines 255..256)

projdir=${PBS_O_WORKDIR}
cd ${projdir}

module load frameworks
source ./venvs/biom3-env/bin/activate

set +e

# ----- Configurations -----
config_path=./configs/grpo/example_gdpo.json
prompts_path=./configs/grpo/prompts/sh3_v04_mixed_4096.txt
stage1_weights=./weights/PenCL/PenCL_V09152023_last.ckpt
stage2_weights=./weights/Facilitator/Facilitator_MMD15.ckpt/last.ckpt
stage3_init_weights=./weights/ProteoScribe/ProteoScribe_SH3_epoch52.ckpt/single_model.pth

# Per-sub-run constants (K=48 per rank → 4 sequences per local tile,
# D=128 set via configs/grpo/pre_unmask_sh3.json). steps=5 for the
# debug-scaling 1 h walltime; save at the final step only.
num_generations=24
steps=5
save_steps=5
beta=0.01
eps=0.20
n_quadrature=2
inner_mc=1
kl_estimator=tokenwise_k3
reward=esmfold_plddt

device=xpu

# Use a separate study_id (v03dbg) so the debug-scaling smoke outputs
# don't get glued into the main v03 analysis pipeline by accident.
study_id=v03dbg
datetime=$(date +%Y%m%d_%H%M%S)
config_name=$(basename "${config_path}" .json)

# Carve DISJOINT hostfile slices (one per sub-run).
hostdir=/tmp/biom3_hostfiles_${PBS_JOBID}
mkdir -p ${hostdir}
sed -n '1,2p'      ${PBS_NODEFILE} > ${hostdir}/hostfile_n2
sed -n '3,6p'      ${PBS_NODEFILE} > ${hostdir}/hostfile_n4
sed -n '7,14p'     ${PBS_NODEFILE} > ${hostdir}/hostfile_n8
sed -n '15,30p'    ${PBS_NODEFILE} > ${hostdir}/hostfile_n16
sed -n '31,62p'    ${PBS_NODEFILE} > ${hostdir}/hostfile_n32
sed -n '63,126p'   ${PBS_NODEFILE} > ${hostdir}/hostfile_n64
sed -n '127,254p'  ${PBS_NODEFILE} > ${hostdir}/hostfile_n128

echo "[combined-dbg] PBS_NODEFILE has $(wc -l < ${PBS_NODEFILE}) entries"
for n in 2 4 8 16 32 64 128; do
    echo "[combined-dbg]   hostfile_n${n}: $(wc -l < ${hostdir}/hostfile_n${n}) entries"
done

mkdir -p logs
source environment.sh

# ----- Aurora CXI tunings for concurrent-mpiexec -----
export FI_CXI_DEFAULT_CQ_SIZE=131072
export FI_CXI_OFLOW_BUF_SIZE=8388608
export FI_CXI_CQ_FILL_PERCENT=20
echo "[combined-dbg] FI_CXI_DEFAULT_CQ_SIZE=${FI_CXI_DEFAULT_CQ_SIZE} FI_CXI_OFLOW_BUF_SIZE=${FI_CXI_OFLOW_BUF_SIZE} FI_CXI_CQ_FILL_PERCENT=${FI_CXI_CQ_FILL_PERCENT}"

# ----- Sub-run launcher (background, with isolation knobs) -----
launch_subjob() {
    local N=$1
    local B=$((2 * N))
    local BG=$((48 * N))
    local hostfile="${hostdir}/hostfile_n${N}"
    local run_id="${config_name}_scaling_${study_id}_n${N}_BG${BG}_s${steps}_V${datetime}"
    local log_fpath="logs/${run_id}.${PBS_JOBID}.o"

    local master_addr=$(head -1 "${hostfile}")
    local master_port=$((29500 + N))

    local sub_ccl_log="${PBS_O_WORKDIR}/logs/ccl_n${N}_${PBS_JOBID}.log"
    local sub_fi_log="${PBS_O_WORKDIR}/logs/fi_n${N}_${PBS_JOBID}.log"
    local fi_cxi_device="cxi$((N % 8))"

    echo "[combined-dbg] launching N=${N} (B=${B}, BG=${BG}) → ${log_fpath}"
    echo "[combined-dbg]   MASTER_ADDR=${master_addr} MASTER_PORT=${master_port}"
    echo "[combined-dbg]   FI_CXI_DEVICE_NAME=${fi_cxi_device}"
    echo "[combined-dbg]   CCL_LOG_FILE=${sub_ccl_log}"

    HOSTFILE_OVERRIDE="${hostfile}" \
    MASTER_ADDR="${master_addr}" \
    MASTER_PORT="${master_port}" \
    CCL_LOG_LEVEL=info \
    CCL_LOG_FILE="${sub_ccl_log}" \
    CCL_ZE_IPC_EXCHANGE_MODE=drmfd \
    FI_CXI_DEVICE_NAME="${fi_cxi_device}" \
    FI_LOG_LEVEL=warn \
    FI_LOG_FILE="${sub_fi_log}" \
    ./scripts/gdpo_train_multinode.sh \
        ${config_path} \
        ${N} \
        ${device} \
        ${run_id} \
        --steps ${steps} \
        --num_generations ${num_generations} \
        --batch_size ${B} \
        --beta ${beta} \
        --eps ${eps} \
        --n_quadrature ${n_quadrature} \
        --inner_mc ${inner_mc} \
        --kl_estimator ${kl_estimator} \
        --save_steps ${save_steps} \
        --reward ${reward} \
        --prompts_path ${prompts_path} \
        --stage1_weights ${stage1_weights} \
        --stage2_weights ${stage2_weights} \
        --stage3_init_weights ${stage3_init_weights} \
        > ${log_fpath} 2>&1 &

    declare -g "pid_n${N}=$!"
    echo "[combined-dbg]   N=${N} background PID=$!"
}

# ----- Launch all 7 sub-runs in parallel (15 s stagger) -----
echo "[combined-dbg] launching all sub-runs at $(date -Iseconds)"
for N in 2 4 8 16 32 64 128; do
    launch_subjob ${N}
    sleep 15
done

# ----- Wait for all to complete -----
echo "[combined-dbg] all sub-runs launched. Waiting on completion..."
declare -A results
for N in 2 4 8 16 32 64 128; do
    pid_var="pid_n${N}"
    pid="${!pid_var}"
    wait ${pid}
    results[${N}]=$?
done

# ----- Final summary -----
echo
echo "================================================================"
echo "[combined-dbg] all sub-runs complete at $(date -Iseconds). Results:"
for N in 2 4 8 16 32 64 128; do
    rc=${results[${N}]}
    status="OK"
    [ ${rc} -ne 0 ] && status="FAILED (exit=${rc})"
    echo "[combined-dbg]   N=${N}: ${status}"
done
echo "================================================================"
