#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N stage3_ft_generalized_n4
#PBS -l walltime=01:00:00
#PBS -l select=4
#PBS -l place=scatter
#PBS -l filesystems=home:flare
#PBS -q debug-scaling
#PBS -j oe
# PBS -M <emailaddress>
# PBS -m be

# Aurora (XPU) 4-node run of the GENERALIZED Stage 3 finetuning path
# (biom3_finetune_stage3 / record_schema JSONL data). Submit from the
# BioM3-dev directory: `qsub jobs/aurora/job_stage3_finetune_generalized_n4.pbs`.
#
# Data path, embedder configs/weights, pretrained weights, finetune-block
# selection, and the record_schema all live in the config below. Only runtime
# knobs are overridden here.

projdir=${PBS_O_WORKDIR}  # Should submit job from the BioM3-dev directory
cd ${projdir}

module load frameworks
source ./venvs/biom3-env/bin/activate

# Configurations to edit
config_path=./configs/stage3_training/finetune_generalized_aurora.json
num_nodes=4                     # Must match #PBS -l select above
epochs=50                       # Number of epochs to finetune
batch_size=8                    # PER-RANK batch. Global = batch_size * num_nodes * num_devices.
                                # At 4*12*8 = 384 this is ~72 steps/epoch on ~27.8k records,
                                # a more realistic finetuning regime than the 64-node scaling test.
use_wandb=True                 # set True only with WANDB_API_KEY exported
resume_from_checkpoint=None     # None to start finetuning fresh

# Constant configurations
num_devices=12                  # tiles per Aurora node
device=xpu

# Construct the run ID
datetime=$(date +%Y%m%d_%H%M%S)
config_name=$(basename "${config_path}" .json)
run_id=${config_name}_n${num_nodes}_d${num_devices}_e${epochs}_V${datetime}

# Direct output to log file
mkdir -p logs
log_fpath=logs/${run_id}.${PBS_JOBID}.o

source environment.sh
./scripts/stage3_finetune_multinode.sh \
    ${config_path} \
    ${num_nodes} \
    ${num_devices} \
    ${device} \
    ${run_id} \
    --epochs ${epochs} \
    --batch_size ${batch_size} \
    --resume_from_checkpoint ${resume_from_checkpoint} \
    --wandb ${use_wandb} \
> ${log_fpath} 2>&1
